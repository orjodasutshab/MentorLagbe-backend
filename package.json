{
  "name": "mentorlagbe-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MentorLagbe REST API & authentication server (Express, MongoDB, BetterAuth, JWT, Stripe, ImgBB).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "NODE_ENV=production tsx src/server.ts",
    "build": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "lint": "tsc --noEmit",
    "build:vercel": "esbuild src/vercel.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.mjs",
    "vercel-build": "npm run build:vercel"
  },
  "dependencies": {
    "@types/node": "^22.14.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.26",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.9.0",
    "stripe": "^23.2.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": "22.x"
  }
}
