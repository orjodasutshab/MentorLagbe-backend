# ============================================================
# MentorLagbe backend — Vercel environment variables
# In Vercel: Project → Settings → Environment Variables.
# Tip: open the first "Key" box and paste this whole file; Vercel splits it into variables.
# NEVER commit the real values. Replace every <...> placeholder.
# ============================================================

NODE_ENV=production

# --- MongoDB Atlas (Database → Connect → Drivers) ---
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/mentorlagbe?retryWrites=true&w=majority
MONGODB_DB_NAME=mentorlagbe

# --- Secrets: make two DIFFERENT 48+ char random values ---
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<random-secret-1>
BETTER_AUTH_SECRET=<random-secret-2>

# --- URLs ---
# Your backend's own Vercel link (no trailing slash)
APP_URL=https://<your-backend>.vercel.app
BETTER_AUTH_URL=https://<your-backend>.vercel.app
# Your frontend link(s). Put http://localhost:3000 too while developing. No trailing slash.
CLIENT_URL=https://<your-frontend>.vercel.app
CORS_ALLOWED_ORIGINS=https://<your-frontend>.vercel.app,http://localhost:3000

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_<...>
STRIPE_WEBHOOK_SECRET=whsec_<...>
ALLOW_PAYMENT_SANDBOX=false

# --- Image upload: ImgBB (assignment requires ImgBB) ---
IMGBB_API_KEY=<your-imgbb-key>
# Cloudinary is optional; leave these out unless you want it (if set, it is used instead of ImgBB)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Keep these as-is for the assignment ---
ENABLE_EXTRA_FEATURES=false
ALLOW_LOCAL_DB_IN_PROD=false
SEED_DEMO_DATA=false
