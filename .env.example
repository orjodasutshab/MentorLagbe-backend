# Server Runtime
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mentorlagbe?retryWrites=true&w=majority
MONGODB_DB_NAME=mentorlagbe
ALLOW_LOCAL_DB_IN_PROD=false
# Demo data (with public passwords) is only ever seeded when NODE_ENV is not production.
SEED_DEMO_DATA=true

# Assignment mode: only the 4 spec collections (users, tuitions, applications, payments) are used.
# Set true to also enable the optional extras (quizzes, coins, resources, messages, notifications).
ENABLE_EXTRA_FEATURES=false

# BetterAuth & JWT Secrets (use 32+ random characters in production)
JWT_SECRET=replace-with-a-32-plus-character-random-jwt-secret
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-better-auth-secret
BETTER_AUTH_URL=http://localhost:5000

# Stripe Checkout & Webhook
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
# Keep false in production: with it true and no Stripe key, anyone could "pay" for Pro for free.
ALLOW_PAYMENT_SANDBOX=false

# Image Upload — Cloudinary (preferred). If these three are set, Cloudinary is used.
CLOUDINARY_CLOUD_NAME=replace_with_your_cloud_name
CLOUDINARY_API_KEY=replace_with_your_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_api_secret
# Optional fallback if Cloudinary is not configured (ImgBB). Leave as-is to skip.
IMGBB_API_KEY=replace_with_your_imgbb_api_key

# Google Sign-In (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
